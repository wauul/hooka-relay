DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
NEXTAUTH_SECRET="generate-with-node-crypto-randomBytes"
NEXTAUTH_URL="http://localhost:3000"
RABBITMQ_URL="amqps://USER:PASSWORD@HOST/VHOST"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

EVENTS_RATE_LIMIT_PER_MINUTE="100"
API_KEY_GRACE_HOURS="24"
RESEND_API_KEY=""
RESEND_FROM="Hooka Relay <invites@waelfz.com>"

# Atomic per-IP limits, separate from the existing per-application limit
EVENTS_IP_LIMIT_PER_MINUTE=1000
AUTH_IP_LIMIT_PER_MINUTE=20
