DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
NEXTAUTH_SECRET="generate-with-node-crypto-randomBytes"
NEXTAUTH_URL="http://localhost:3000"
RABBITMQ_URL="amqps://USER:PASSWORD@HOST/VHOST"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

EVENTS_RATE_LIMIT_PER_MINUTE="100"
API_KEY_GRACE_HOURS="24"
RESEND_API_KEY=""
RESEND_FROM="Hooka Relay <invites@waelfz.com>"

# Atomic per-IP limits, separate from the existing per-application limit
EVENTS_IP_LIMIT_PER_MINUTE=1000
AUTH_IP_LIMIT_PER_MINUTE=20

# Required on both web and worker. Generate 32 random bytes as 64 hex characters.
# Back up securely; losing this key makes stored endpoint secrets unrecoverable.
ENDPOINT_SECRET_ENCRYPTION_KEY=""

PORTAL_IP_LIMIT_PER_MINUTE="30"

# Signing-secret rotation: existing receivers retain their key during this window.
SIGNING_SECRET_GRACE_HOURS="168"
ENDPOINT_SECRET_KEY_ID="k1"
# Optional explicit k1 key; otherwise ENDPOINT_SECRET_ENCRYPTION_KEY is used.
# ENDPOINT_SECRET_ENCRYPTION_KEY_K1=""

# Optional retry queue schedules; omitted values preserve existing timing.
# RETRY_STANDARD_QUEUES="retry-delay-30s,retry-delay-2m,retry-delay-5m,retry-delay-15m"
# RETRY_AGGRESSIVE_QUEUES="retry-delay-30s,retry-delay-30s,retry-delay-30s,retry-delay-2m,retry-delay-2m,retry-delay-5m"
# RETRY_RELAXED_QUEUES="retry-delay-5m,retry-delay-15m,retry-delay-30m"
# RESEND_API_KEY, RESEND_FROM and NEXTAUTH_URL are also used by the worker.
