generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}
enum AttemptStatus {
  SUCCESS
  FAILED
  TIMEOUT
  SKIPPED_CIRCUIT_OPEN
  DEAD_LETTERED
}
model User {
  id String @id @default(cuid())
  email String @unique
  hashedPassword String
  createdAt DateTime @default(now())
  applications Application[]
}
model Application {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  name String
  apiKey String @unique
  createdAt DateTime @default(now())
  endpoints Endpoint[]
  events Event[]
}
model Endpoint {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id])
  url String
  secret String
  eventTypes String[]
  circuitState CircuitState @default(CLOSED)
  consecutiveFailures Int @default(0)
  circuitOpenedAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  diagnosis Json?
  diagnosedAt DateTime?
  createdAt DateTime @default(now())
  attempts DeliveryAttempt[]
  deliveries Delivery[]
}
model Event {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id])
  idempotencyKey String
  type String
  payload Json
  createdAt DateTime @default(now())
  attempts DeliveryAttempt[]
  deliveries Delivery[]
  @@unique([applicationId, idempotencyKey])
}
model Delivery {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id])
  endpointId String
  endpoint Endpoint @relation(fields: [endpointId], references: [id])
  generation Int @default(0)
  attemptNumber Int @default(1)
  status String @default("PENDING")
  dueAt DateTime @default(now())
  publishedAt DateTime?
  delayQueue String?
  createdAt DateTime @default(now())
  @@unique([eventId, endpointId, generation])
  @@index([status, dueAt])
}
model DeliveryAttempt {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id])
  endpointId String
  endpoint Endpoint @relation(fields: [endpointId], references: [id])
  deliveryId String
  attemptNumber Int
  status AttemptStatus
  httpStatusCode Int?
  responseBody String?
  error String?
  durationMs Int?
  requestBody String?
  requestHeaders Json?
  responseHeaders Json?
  createdAt DateTime @default(now())
  @@index([endpointId, createdAt])
}
model FakeReceipt {
  key String @id
  calls Int @default(0)
  createdAt DateTime @default(now())
}
