generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
}
enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}
enum AttemptStatus {
  SUCCESS
  FAILED
  TIMEOUT
  SKIPPED_CIRCUIT_OPEN
  DEAD_LETTERED
}
model User {
  id String @id @default(cuid())
  email String @unique
  displayName String?
  hashedPassword String?
  emailVerified DateTime?
  sessionVersion Int @default(0)
  oauthAccounts OAuthAccount[]
  authTokens AuthToken[]
  createdAt DateTime @default(now())
  legacyApplications Application[]
  memberships WorkspaceMember[]
  sentInvites WorkspaceInvite[]
}
model Application {
  id String @id @default(cuid())
  legacyUserId String? @map("userId")
  legacyUser User? @relation(fields: [legacyUserId], references: [id], onDelete: Restrict)
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  // SHA-256 digests; legacy column name retained to avoid a structural migration.
  currentApiKey String @unique @map("apiKey")
  previousApiKey String? @unique
  previousApiKeyExpiresAt DateTime?
  portalTokenHash String? @unique
  portalTokenEncrypted String?
  createdAt DateTime @default(now())
  @@index([workspaceId])
  apiKeys ApplicationKey[]
  eventTypes EventTypeVersion[]
  recoveries RecoveryJob[]
  notifications OperationalNotice[]
  recoveryAvailableAt DateTime?
  schemas EventSchema[]
  admissions EventAdmission[]
  endpoints Endpoint[]
  events Event[]
  webhookSources WebhookSource[]
}
model Endpoint {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  url String
  portalOwnerHash String?
  @@index([applicationId, portalOwnerHash])
  // Versioned AES-256-GCM ciphertext, bound to applicationId.
  secret String
  secretVersion Int @default(0)
    signatureFormat SignatureFormat @default(STANDARD)
  previousSecret String?
  previousSecretVersion Int?
  previousSecretExpiresAt DateTime?
  eventTypes String[]
  status EndpointStatus @default(ACTIVE)
  environment String @default("production")
  kind EndpointKind @default(BUSINESS)
  customHeadersEncrypted String?
  deliveryRatePerMinute Int?
  nextDeliveryAt DateTime?
  transform String?
  retryPolicy RetryPolicy @default(STANDARD)
  circuitState CircuitState @default(CLOSED)
  consecutiveFailures Int @default(0)
  circuitOpenedAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  diagnosis Json?
  diagnosedAt DateTime?
  createdAt DateTime @default(now())
  attempts DeliveryAttempt[]
  deliveries Delivery[]
  webhookSource WebhookSource?
  routingDestination RoutingDestination?
  routingRuns RoutingDestinationRun[]
}
enum WebhookProvider {
  STRIPE
  GITHUB
  SLACK
  SHOPIFY
  TWILIO
  WOOCOMMERCE
  LINEAR
  SQUARE
  INTERCOM
  MAILGUN
  ZOOM
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  TIKTOK
    LINKEDIN
    ZENDESK
    TYPEFORM
    PADDLE
    CUSTOM
}
enum WebhookSourceStatus {
  SETUP_IN_PROGRESS
  ACTIVE
  PAUSED
}
model WebhookSource {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  endpointId String? @unique
  endpoint Endpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  name String
  provider WebhookProvider
  ingestionToken String @unique
  encryptedProviderSecret String?
  manualConfig Json?
  destinationUrl String?
  destinationGroups DestinationGroup[]
  routingExecutions RoutingExecution[]
  setupStep Int @default(2)
  verificationTokenHash String?
  status WebhookSourceStatus @default(SETUP_IN_PROGRESS)
  lastEventReceivedAt DateTime?
  lastVerifiedAt DateTime?
  lastVerificationFailure String?
  lastVerificationFailureAt DateTime?
  createdAt DateTime @default(now())
    events Event[]
    receipts InboundReceipt[]
    liveSessions InboundLiveSession[]
  @@index([applicationId, createdAt])
}
enum RoutingTriggerCondition {
  ALWAYS
  ON_PREVIOUS_SUCCESS
  ON_PREVIOUS_FAILURE
}
enum RoutingSuccessPolicy {
  ALL_MUST_SUCCEED
  ANY_MUST_SUCCEED
}
enum RoutingRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}
model DestinationGroup {
  id String @id @default(cuid())
  webhookSourceId String
  webhookSource WebhookSource @relation(fields: [webhookSourceId], references: [id], onDelete: Cascade)
  order Int
  triggerCondition RoutingTriggerCondition @default(ALWAYS)
  successPolicy RoutingSuccessPolicy @default(ALL_MUST_SUCCEED)
  destinations RoutingDestination[]
  @@unique([webhookSourceId, order])
}
model RoutingDestination {
  id String @id @default(cuid())
  destinationGroupId String
  destinationGroup DestinationGroup @relation(fields: [destinationGroupId], references: [id], onDelete: Cascade)
  endpointId String @unique
  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  @@index([destinationGroupId])
}
model RoutingExecution {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  webhookSourceId String
  webhookSource WebhookSource @relation(fields: [webhookSourceId], references: [id], onDelete: Cascade)
  generation Int @default(0)
  status RoutingRunStatus @default(RUNNING)
  createdAt DateTime @default(now())
  completedAt DateTime?
  groups RoutingGroupRun[]
  @@unique([eventId, generation])
  @@index([status, createdAt])
}
model RoutingGroupRun {
  id String @id @default(cuid())
  executionId String
  execution RoutingExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  order Int
  triggerCondition RoutingTriggerCondition
  successPolicy RoutingSuccessPolicy
  status RoutingRunStatus @default(PENDING)
  reason String?
  destinations RoutingDestinationRun[]
  @@unique([executionId, order])
}
model RoutingDestinationRun {
  id String @id @default(cuid())
  groupRunId String
  groupRun RoutingGroupRun @relation(fields: [groupRunId], references: [id], onDelete: Cascade)
  endpointId String?
  endpoint Endpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  url String
  deliveryId String? @unique
  delivery Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  @@index([groupRunId])
}
model Event {
  id String @id @default(cuid())
  traceparent String?
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  webhookSourceId String?
  webhookSource WebhookSource? @relation(fields: [webhookSourceId], references: [id], onDelete: SetNull)
  idempotencyKey String
  type String
  payload Json
  operational Boolean @default(false)
  createdAt DateTime @default(now())
  attempts DeliveryAttempt[]
    deliveries Delivery[]
    routingExecutions RoutingExecution[]
    inboundReceipt InboundReceipt?
  @@unique([applicationId, idempotencyKey])
  @@index([applicationId, createdAt, id])
  @@index([webhookSourceId, createdAt])
}
model Delivery {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId String
  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  generation Int @default(0)
  attemptNumber Int @default(1)
  status String @default("PENDING")
  dueAt DateTime @default(now())
  publishedAt DateTime?
  delayQueue String?
  createdAt DateTime @default(now())
  routingRun RoutingDestinationRun?
  @@unique([eventId, endpointId, generation])
  @@index([status, dueAt])
}
model DeliveryAttempt {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId String
  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  deliveryId String
  attemptNumber Int
  status AttemptStatus
  httpStatusCode Int?
  responseBody String?
  error String?
  durationMs Int?
  requestBody String?
  requestHeaders Json?
  responseHeaders Json?
  createdAt DateTime @default(now())
  @@index([endpointId, createdAt])
}
model FakeReceipt {
  key String @id
  calls Int @default(0)
  createdAt DateTime @default(now())
}

model EventAdmission {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}
enum InviteStatus {
  DECLINED
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}
enum EndpointStatus {
  ACTIVE
  PAUSED
}
model Workspace {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  members WorkspaceMember[]
  applications Application[]
  invites WorkspaceInvite[]
}
model WorkspaceMember {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role WorkspaceRole
  joinedAt DateTime @default(now())
  @@unique([workspaceId, userId])
  @@index([userId])
}
model WorkspaceInvite {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email String
  role WorkspaceRole
  token String @unique
  invitedByUserId String
  invitedBy User @relation(fields: [invitedByUserId], references: [id])
  status InviteStatus @default(PENDING)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([workspaceId, status])
}
model IpRateBucket {
  key String
  bucket BigInt
  hits Int
  expiresAt DateTime
  @@id([key, bucket])
  @@index([expiresAt])
}

model EventSchema {
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventType String
  schema Json
  createdAt DateTime @default(now())
  @@id([applicationId, eventType])
}

enum RetryPolicy {
  STANDARD
  AGGRESSIVE
  RELAXED
}
model SupportDocument {
  id String @id
  source String
  text String
  revision String
  embedding Unsupported("vector(384)")
}
model SupportCorpus {
  id Int @id
  revision String
}
model SupportAnswerCache {
  key String @id
  answer String
  expiresAt DateTime
  @@index([expiresAt])
}
model SupportDecision {
  id String @id
  inScope Boolean
  reason String
  cacheHit Boolean @default(false)
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([createdAt])
}

enum SignatureFormat {
  STANDARD
}

model InboundReceipt {
  id String @id @default(cuid())
  sourceId String
  source WebhookSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  eventId String? @unique
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  provider WebhookProvider
  eventType String?
  rawBody String @db.Text
  searchText String? @db.Text
  rawHeaders Json
  verified Boolean
  failureReason String?
  receivedAt DateTime @default(now())
  replays InboundReplay[]
  liveAttempts InboundLiveAttempt[]
  @@index([sourceId, receivedAt, id])
  @@index([sourceId, verified, receivedAt])
}

model InboundReplay {
  id String @id @default(cuid())
  receiptId String
  receipt InboundReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  userId String
  generation Int?
  createdAt DateTime @default(now())
  @@index([receiptId, createdAt])
}

model InboundLiveSession {
  id String @id
  sourceId String
  source WebhookSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  connectedAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  @@index([sourceId, lastSeenAt])
}

model InboundLiveAttempt {
  id String @id @default(cuid())
  receiptId String
  receipt InboundReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  sessionId String
  replayId String?
  status String
  httpStatusCode Int?
  responseBody String?
  error String?
  durationMs Int?
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([receiptId, createdAt])
  @@index([sessionId, createdAt])
}
model AuditLog {
  id String @id @default(cuid())
  applicationId String
  endpointId String
  actorId String
  action String
  secretVersion Int
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
  @@index([endpointId, createdAt])
}

enum EndpointKind {
  BUSINESS
  OPERATIONAL
  INBOUND
}
enum ApplicationKeyScope {
  READ_ONLY
  INGEST_ONLY
}
model ApplicationKey {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name String
  hash String @unique
  scope ApplicationKeyScope
  expiresAt DateTime?
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  @@index([applicationId])
}
model EventTypeVersion {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventType String
  version Int
  description String
  schema Json?
  createdAt DateTime @default(now())
  @@unique([applicationId, eventType, version])
}
model OperationalNotice {
  id String @id
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  endpointId String
  since DateTime
  sentAt DateTime?
  nextAttemptAt DateTime @default(now())
  attempts Int @default(0)
  @@index([sentAt, nextAttemptAt])
}

model RecoveryJob {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  endpointId String?
  since DateTime
  until DateTime @default(now())
  status String @default("PENDING")
  queued Int @default(0)
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}

model OAuthAccount {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String
  providerAccountId String
  @@unique([provider, providerAccountId])
  @@index([userId])
}
model AuthToken {
  hash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String
  expiresAt DateTime
  createdAt DateTime @default(now())
  callbackPath String @default("/dashboard")
  @@index([userId, purpose])
  @@index([expiresAt])
}
