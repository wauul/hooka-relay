generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}
enum AttemptStatus {
  SUCCESS
  FAILED
  TIMEOUT
  SKIPPED_CIRCUIT_OPEN
  DEAD_LETTERED
}
model User {
  id String @id @default(cuid())
  email String @unique
  displayName String?
  hashedPassword String
  createdAt DateTime @default(now())
  legacyApplications Application[]
  memberships WorkspaceMember[]
  sentInvites WorkspaceInvite[]
}
model Application {
  id String @id @default(cuid())
  legacyUserId String? @map("userId")
  legacyUser User? @relation(fields: [legacyUserId], references: [id], onDelete: Restrict)
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  // SHA-256 digests; legacy column name retained to avoid a structural migration.
  currentApiKey String @unique @map("apiKey")
  previousApiKey String? @unique
  previousApiKeyExpiresAt DateTime?
  portalTokenHash String? @unique
  portalTokenEncrypted String?
  createdAt DateTime @default(now())
  @@index([workspaceId])
  schemas EventSchema[]
  admissions EventAdmission[]
  endpoints Endpoint[]
  events Event[]
}
model Endpoint {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  url String
  portalOwnerHash String?
  @@index([applicationId, portalOwnerHash])
  // Versioned AES-256-GCM ciphertext, bound to applicationId.
  secret String
  secretVersion Int @default(0)
  signatureFormat SignatureFormat @default(LEGACY)
  previousSecret String?
  previousSecretVersion Int?
  previousSecretExpiresAt DateTime?
  eventTypes String[]
  status EndpointStatus @default(ACTIVE)
  retryPolicy RetryPolicy @default(STANDARD)
  circuitState CircuitState @default(CLOSED)
  consecutiveFailures Int @default(0)
  circuitOpenedAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  diagnosis Json?
  diagnosedAt DateTime?
  createdAt DateTime @default(now())
  attempts DeliveryAttempt[]
  deliveries Delivery[]
}
model Event {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  idempotencyKey String
  type String
  payload Json
  createdAt DateTime @default(now())
  attempts DeliveryAttempt[]
  deliveries Delivery[]
  @@unique([applicationId, idempotencyKey])
}
model Delivery {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId String
  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  generation Int @default(0)
  attemptNumber Int @default(1)
  status String @default("PENDING")
  dueAt DateTime @default(now())
  publishedAt DateTime?
  delayQueue String?
  createdAt DateTime @default(now())
  @@unique([eventId, endpointId, generation])
  @@index([status, dueAt])
}
model DeliveryAttempt {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId String
  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  deliveryId String
  attemptNumber Int
  status AttemptStatus
  httpStatusCode Int?
  responseBody String?
  error String?
  durationMs Int?
  requestBody String?
  requestHeaders Json?
  responseHeaders Json?
  createdAt DateTime @default(now())
  @@index([endpointId, createdAt])
}
model FakeReceipt {
  key String @id
  calls Int @default(0)
  createdAt DateTime @default(now())
}

model EventAdmission {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}
enum InviteStatus {
  DECLINED
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}
enum EndpointStatus {
  ACTIVE
  PAUSED
}
model Workspace {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  members WorkspaceMember[]
  applications Application[]
  invites WorkspaceInvite[]
}
model WorkspaceMember {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role WorkspaceRole
  joinedAt DateTime @default(now())
  @@unique([workspaceId, userId])
  @@index([userId])
}
model WorkspaceInvite {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email String
  role WorkspaceRole
  token String @unique
  invitedByUserId String
  invitedBy User @relation(fields: [invitedByUserId], references: [id])
  status InviteStatus @default(PENDING)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([workspaceId, status])
}
model IpRateBucket {
  key String
  bucket BigInt
  hits Int
  expiresAt DateTime
  @@id([key, bucket])
  @@index([expiresAt])
}

model EventSchema {
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventType String
  schema Json
  createdAt DateTime @default(now())
  @@id([applicationId, eventType])
}

enum RetryPolicy {
  STANDARD
  AGGRESSIVE
  RELAXED
}
model SupportDocument {
  id String @id
  source String
  text String
  revision String
  embedding Unsupported("vector(384)")
}
model SupportCorpus {
  id Int @id
  revision String
}
model SupportAnswerCache {
  key String @id
  answer String
  expiresAt DateTime
  @@index([expiresAt])
}
model SupportDecision {
  id String @id
  inScope Boolean
  reason String
  cacheHit Boolean @default(false)
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([createdAt])
}

enum SignatureFormat {
  LEGACY
  STANDARD
}
model AuditLog {
  id String @id @default(cuid())
  applicationId String
  endpointId String
  actorId String
  action String
  secretVersion Int
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
  @@index([endpointId, createdAt])
}
