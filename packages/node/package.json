{
  "name": "hooka-relay-node",
  "version": "1.0.0",
  "description": "Typed Hooka Relay event client and Standard Webhooks verification",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wauul/hooka-relay.git",
    "directory": "packages/node"
  },
  "homepage": "https://hooka-relay.vercel.app/docs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "hooka-relay": "file:../..",
    "standardwebhooks": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
