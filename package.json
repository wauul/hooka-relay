{
  "name": "hooka-relay",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:worker": "prisma generate && tsc -p tsconfig.worker.json",
    "lint": "eslint app components lib worker tests middleware.ts --max-warnings 0",
    "support:ingest": "tsx scripts/ingest-support.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "amqplib": "^0.10.9",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "next-auth": "4.24.15",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.20.5",
    "zod": "^3.25.76",
    "ajv": "8.20.0",
    "@xenova/transformers": "2.17.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "prisma": "6.19.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.30.3",
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "effect": "3.22.2",
    "postcss": "$postcss",
    "sharp": "0.35.4",
    "protobufjs": "7.6.5"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.22.2",
      "postcss": "8.5.28",
      "sharp": "0.35.4",
      "protobufjs": "7.6.5"
    }
  }
}
