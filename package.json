{
  "name": "hooka-relay",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack && node scripts/remove-web-sourcemaps.mjs",
    "start": "next start",
    "worker": "tsx worker/bootstrap.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:worker": "prisma generate && tsc -p tsconfig.worker.json",
    "lint": "eslint app components lib worker tests proxy.ts --max-warnings 0",
    "support:ingest": "tsx scripts/ingest-support.ts",
    "db:migrate-endpoint-secrets": "tsx scripts/migrate-endpoint-secrets.ts",
    "sdk:generate": "node scripts/openapi.mjs && node scripts/generate-sdk-types.mjs",
    "sdk:test": "tsc -p packages/node/tsconfig.json && node --test packages/node/tests/*.test.mjs",
    "start:worker": "node dist/worker/bootstrap.js",
    "sentry:worker:sourcemaps": "node scripts/sentry-worker-sourcemaps.mjs",
    "audit:security": "node --test scripts/security-audit.test.mjs && node scripts/security-audit.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-email/render": "2.1.0",
    "@sentry/core": "10.76.0",
    "@sentry/nextjs": "10.76.0",
    "@sentry/node": "10.76.0",
    "@sentry/opentelemetry": "10.76.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xenova/transformers": "2.17.2",
    "ajv": "8.20.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-auth": "4.24.15",
    "pg": "^8.23.0",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swagger-ui-react": "5.33.0",
    "tsx": "^4.23.15",
    "ws": "8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sentry/cli": "3.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "prisma": "7.10.0",
    "standardwebhooks": "1.1.1",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.12.0"
  },
  "packageManager": "pnpm@10.30.3",
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "effect": "3.22.2",
    "mysql2": "3.24.4",
    "postcss": "$postcss",
    "sharp": "0.35.4",
    "protobufjs": "7.6.5"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.22.2",
      "mysql2": "3.24.4",
      "postcss": "8.5.28",
      "sharp": "0.35.4",
      "protobufjs": "7.6.5"
    }
  }
}
